# Copia este archivo como .env (no se sube a git) y ajusta los valores.
# Todas las variables son opcionales: los valores de abajo son los defaults.

# ============ LLM: switch local / online ============
# local  = Ollama en esta computadora (qwen3.5:9b)
# online = API de Claude (claude-haiku-5-5); requiere ANTHROPIC_API_KEY
# AVISO: en modo online el texto OCR de los documentos se envía a Anthropic. Las bases del reto
# piden no subir los documentos a otros servicios: confírmalo con el comité antes de usarlo.
LLM_PROVIDER=local

# ---- Local (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Contexto fijo para todos los agentes (cambiarlo entre llamadas recarga el modelo)
OLLAMA_NUM_CTX=8192
# 99 = todas las capas en GPU (en la RTX 4060 es ~30 % más rápido que el reparto automático)
OLLAMA_NUM_GPU=99
OLLAMA_KEEP_ALIVE=30m
# Recomendado (variable del SERVIDOR de Ollama, no de este .env): OLLAMA_NUM_PARALLEL=4
# hace que las 4 extracciones corran a la vez en la GPU (~40 % menos tiempo de LLM).

# ---- Online (Claude) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# ---- Comunes ----
LLM_TIMEOUT_S=120
# Caracteres por documento que se envían al LLM (local / online)
LLM_MAX_CHARS_LOCAL=12000
LLM_MAX_CHARS_ONLINE=40000
# auto: el dictamen lo redacta el LLM salvo que no alcance el tiempo objetivo; si | no
DICTAMEN_LLM=auto
TIEMPO_OBJETIVO_S=60

# ============ OCR (Tesseract en paralelo) ============
# spa_fast (tessdata_fast) es ~3x más rápido que spa (tessdata_best) con calidad similar
OCR_LANG=spa_fast
OCR_DPI=250
# 0 = automático (núcleos lógicos, máx. 16)
OCR_WORKERS=0
# 1 = reutiliza el OCR de archivos idénticos (SHA-256) en output/cache_analisis/
OCR_CACHE=1

# ============ Reglas de negocio ============
USO_REQUERIDO=comercial: tienda de autoservicio / minisúper (comercio de productos básicos)
# Fecha contra la que se evalúan vigencias y predial (vacío = hoy). Ej.: 2025-11-21
FECHA_REFERENCIA=
# 0: el predial debe ser del año de referencia; 1: se acepta el del año anterior
PREDIAL_TOLERANCIA_ANIOS=0
# Diferencia relativa aceptada en superficies entre documentos (0.05 = 5 %)
SUPERFICIE_TOLERANCIA=0.05
# Si la licencia de uso de suelo no indica vigencia, antigüedad máxima aceptada
USO_SUELO_ANTIGUEDAD_MAX_ANIOS=1
