# Copia este archivo a .env.local (no se sube a git) y completa los valores.
# Client ID de OAuth 2.0 (Google Cloud Console > Credenciales > ID de cliente de OAuth, tipo "Aplicacion web").
# Origenes JS autorizados: https://localhost:5173 (y tu dominio de produccion).
VITE_GOOGLE_CLIENT_ID=
# Cuentas de Google con acceso y su rol, separadas por coma: correo:rol (rol = admin | gestor)
VITE_GOOGLE_ALLOWED=persona1@gmail.com:admin,persona2@gmail.com:gestor
